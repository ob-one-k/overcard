# Copy to .env (never commit .env). Every variable the server reads:

# PostgreSQL connection string (required in production)
DATABASE_URL=postgres://localhost/overcard_dev
# TLS to the database: verify | require | off  (default: require in production, off otherwise)
# DATABASE_SSL=require
# Max pooled connections (default 20)
# DATABASE_POOL_MAX=20

# development | test | production. Only development/test may run without JWT_SECRET.
NODE_ENV=development
# 32+ random characters in production, e.g.: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# Session length (default 24h)
# JWT_EXPIRES=24h

# Frontend origin allowed to call the API cross-site (e.g. https://your-app.vercel.app)
CORS_ORIGIN=
# Secret for the "Create organization" sign-up form. Unset = org creation disabled.
MASTER_CODE=
# Public app URL, used in owner recovery links
APP_URL=http://localhost:5173

# Demo orgs, demo seeding on boot and one-click demo sign-in (default on)
DEMO_MODE=on

PORT=3000
# Automated tests / load test only — ignored in production
# RATE_LIMITS=off

# Frontend build (Vite): API origin when it is served from a different domain
# VITE_API_URL=https://overcard-api.onrender.com
