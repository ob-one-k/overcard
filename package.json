{
  "name": "overcard",
  "version": "2.1.0",
  "private": true,
  "scripts": {
    "server": "NODE_ENV=development PORT=3001 node server/index.js",
    "client": "vite",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "build": "vite build",
    "start": "npm run build && node server/index.js",
    "test": "node --test --test-concurrency=1 tests/",
    "loadtest": "node scripts/loadtest.mjs",
    "owner-reset": "node server/scripts/ownerReset.js",
    "db-reset": "node server/scripts/resetDatabase.js"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "vite": "^8.3.5"
  },
  "engines": {
    "node": "24.x"
  }
}
